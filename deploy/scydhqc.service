[Unit]
Description=食材预订系统 scydhqc (uvicorn :13000)
After=network.target

[Service]
WorkingDirectory=%h/scydhqc/backend
ExecStart=%h/scydhqc/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 13000 --proxy-headers --forwarded-allow-ips=172.28.200.80,172.28.200.101
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
